    <string name="capacity">容量</string>
    <string name="capacity_summary">显示电池容量或储能水平，单位为毫安时（mAh）。该数值根据系统的电荷计数器和电池电量参数计算得出，反映电池的实际电荷容量，而不是百分比。</string>
    <string name="charging_summary">估算设备接入电源后电池充至 100% 所需的剩余时间。该数值通过跟踪一段时间内电池电量的增长，并使用滚动平均公式计算得出，即根据经过的时间、电量增长幅度以及充满前的剩余电量进行估算。</string>
    <string name="charging_status_ac">交流电：充电</string>
    <string name="charging_status_usb">USB 充电</string>
    <string name="charging_status_wireless">无线充电</string>
    <string name="copyright_text" translatable="false">Copyright: © 2026 sunilpaulmathew</string>
    <string name="current">电流</string>
    <string name="current_summary">测量流入或流出电池的电流，单位为毫安（mA）。正值表示充电时电流流入，负值表示电量消耗。该数据直接通过 Android 的系统 BatteryManager API 获取。</string>
    <string name="developer_contact">联系开发者</string>
    <string name="developer_contact_description">需要帮助或有任何反馈？请联系开发者</string>
    <string name="discharging">放电中</string>
    <string name="discharging_summary">估算电池在设备完全关机前还能使用多长时间。该数值通过跟踪一段时间内电池电量的持续下降进行计算，并使用滚动权重因子平滑结果，再结合当前电量和耗电速率进行估算。</string>
    <string name="exit">退出</string>
    <string name="exit_confirmation_toast">再次按返回键即可退出 Battery Plus…</string>
    <string name="general">常规</string>
    <string name="health">健康度</string>
    <string name="health_summary">反映电池电芯的整体物理状态和老化程度（例如良好、过热、失效）。该信息直接读取 Android 运行环境提供的系统健康状态标志。</string>
    <string name="initializing_Status">正在初始化电池监测…</string>
    <string name="miscellaneous">其他</string>
    <string name="notification_content">通知内容</string>
    <string name="notification_content_description">选择在实时通知中显示哪些电池统计数据和指标。</string>
    <string name="notification_start">显示实时通知</string>
    <string name="notification_start_description">在通知栏中实时显示电池数据，并在电池电量低或已充满时提醒你。</string>
    <string name="permission_denied_notification">通知权限已被拒绝。再次点击按钮重试，或前往“应用信息 > 通知”手动开启通知权限。</string>
    <string name="permission_denied_title">需要权限</string>
    <string name="power">功率</string>
    <string name="power_summary">实时反映能量消耗或输出速率，单位为瓦特（W）。该数值通过将当前电流（转换为安培）乘以当前系统电压计算得出。</string>
