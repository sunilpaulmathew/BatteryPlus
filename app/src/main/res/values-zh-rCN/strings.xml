    <string name="start_on_boot">开机启动</string>
    <string name="start_on_boot_description">设备开机后自动恢复电池监测和通知。需要先启用实时通知。</string>
    <string name="status">状态</string>
    <string name="status_analyzing">正在分析…</string>
    <string name="stop">停止</string>
